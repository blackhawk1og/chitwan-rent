VITE_API_URL=http://localhost:4000/api

# Optional. CARTO basemap tile API key, attached to the Dark Matter tile URLs
# as `?key=...` (see client/src/lib/mapConfig.js). Keys are issued per-domain,
# free up to CARTO's fair-use limit of 5 million tile requests/month, from
# https://carto.com/basemaps/apikey/ — no CARTO account needed. Leave unset and
# the map still loads unkeyed. Baked into the client bundle at build time, so
# treat it as public and keep it domain-scoped.
CARTO_API_KEY="your key"
