PORT=4000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/chitwan_rent
JWT_SECRET=dev_secret_change_me
CLIENT_ORIGIN=http://localhost:5173

# Base URL this server is reachable at — used to build the link inside
# verification emails (see routes/verifyListing.js). Defaults to
# http://localhost:$PORT when unset, so local dev works without setting it.
SERVER_BASE_URL=http://localhost:4000

# API key from sendgrid.com
SENDGRID_API_KEY=

# Shared password for the internal-only /internal/dashboard
DASHBOARD_PASSWORD=

# Cloudinary account credentials (free tier at https://cloudinary.com)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Key for the HMAC that hashes listing delete codes (flats.delete_code_hash).
# REQUIRED — the server refuses to start without it, and there is deliberately
# no fallback value: a 10-digit code hashed with a bare/guessable digest can be
# brute-forced offline in seconds if the hash ever leaks. Generate a fresh one
# per environment (never reuse the dev value in production) with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# Rotating this value invalidates every existing delete code — reissue them
# with: npm run rotate:flat-secrets
DELETE_CODE_HMAC_SECRET=
