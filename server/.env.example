PORT=4000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/chitwan_rent
JWT_SECRET=dev_secret_change_me
CLIENT_ORIGIN=http://localhost:5173

# Base URL this server is reachable at — used to build the link inside
# verification emails (see routes/verifyListing.js). Defaults to
# http://localhost:$PORT when unset, so local dev works without setting it.
SERVER_BASE_URL=http://localhost:4000

# API key from resend.com — used to send verification/delete-code/digest/
# report-removal/interest-notification emails via the Resend API
# (src/lib/email.js). Get one free at https://resend.com/api-keys.
# Replaces the old EMAIL_USER/EMAIL_PASS Gmail+Nodemailer setup (removed —
# Gmail SMTP doesn't work on Render's free tier; outbound SMTP times out
# there, while Resend's HTTPS API is unaffected). Until a sending domain is
# verified in the Resend dashboard, email.js sends from Resend's shared
# onboarding@resend.dev address, which Resend restricts to only deliver to
# the email address the Resend account itself was signed up with — fine for
# local dev, but it won't reach real users in production until a domain is
# verified there.
RESEND_API_KEY=

# Optional — set as the Reply-To on every weekly match-digest email
# (src/lib/digestJob.js, src/lib/email.js), and named in the email body, so
# recipients replying with questions land somewhere real instead of a
# personal inbox. Leave unset to send with no Reply-To override at all.
DIGEST_REPLY_TO=

# Shared password for the internal-only /internal/dashboard read/lookup/
# delete-user tool (src/lib/dashboardAuth.js, src/routes/dashboard.js) — one
# password for the whole dashboard, no per-admin accounts. Required for that
# route to work at all; login is refused (503) while this is unset.
DASHBOARD_PASSWORD=
